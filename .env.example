# Copy to .env and edit (optional). start.sh loads this automatically.
# cp .env.example .env

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
KAP_LANGUAGE=tr
KAP_WATCHLIST=THYAO
KAP_PROMPT_PATH=../pi-llm/prompts/kap_sentiment.txt
# Default scrape interval is 1 hour (3600000). Override if needed:
# KAP_POLL_INTERVAL_MS=3600000

# Stocks (Yahoo Finance — no API key). Separate from KAP_WATCHLIST.
STOCKS_WATCHLIST=THYAO,ASELS
# STOCKS_POLL_INTERVAL_MS=60000

# Paper trading (BIST-only virtual portfolio). Runtime state under data/stocks/.
PAPER_STARTING_CASH_TRY=100000
# PAPER_MIN_FILL_DELAY_MS=30000
# PAPER_HALF_SPREAD=0.0005
# PAPER_FEE_RATE=0.0005
# PAPER_DAILY_LIMIT_PCT=0.10
# PAPER_LIMIT_SOFT_ZONE=0.02
# PAPER_PARTIAL_FILL_MAX=50
# PAPER_ORDER_TTL_MS=21600000
# Auto strategy (KAP sentiment → orders; exits: +8% / −5% / ~10d)
# PAPER_AUTO_TRADE=1
# PAPER_CONFIDENCE_MIN=0.55
# PAPER_POSITION_PCT=0.1
# PAPER_MAX_SYMBOL_PCT=0.25
# PAPER_COOLDOWN_MS=1800000
# PAPER_TAKE_PROFIT_PCT=0.08
# PAPER_STOP_LOSS_PCT=0.05
# PAPER_MAX_HOLD_MS=864000000

# Investing.com official RSS (headlines only — no HTML scrape).
# Toggle from the Stocks Paper desk UI (persisted under data/stocks/).
# Optional: NEWS_RSS_ENABLED=1 only seeds the first run default.
# NEWS_RSS_ENABLED=0
# NEWS_RSS_POLL_MS=900000
# NEWS_RSS_FEEDS=https://tr.investing.com/rss/stock.rss,https://tr.investing.com/rss/news.rss
# NEWS_RSS_MAX_PER_POLL=8

# AI Info page / widgets poll interval for Ollama model metadata
# AIINFO_POLL_MS=30000

# HOMEHUB_WATCH_SECONDS=60
